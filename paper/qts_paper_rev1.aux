\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Anomaly explanation map. (a) Normal ECG: per-window scores remain low, with minimal above-threshold highlighting. (b) Abnormal ECG: contiguous high-score regions (red shading) precisely localise the morphological deviation. Dashed line indicates the threshold (90th percentile of normal window scores). Global anomaly scores $S(\mathbf  {x})$ are shown in the upper-right corner of each panel.}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:explain}{{8}{17}{Anomaly explanation map. (a) Normal ECG: per-window scores remain low, with minimal above-threshold highlighting. (b) Abnormal ECG: contiguous high-score regions (red shading) precisely localise the morphological deviation. Dashed line indicates the threshold (90th percentile of normal window scores). Global anomaly scores $S(\mathbf {x})$ are shown in the upper-right corner of each panel}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Template--signal alignment within a single 310\,ms (QT-interval) window. (a) Normal window: the best-matching template (dashed blue) closely tracks the signal (solid black), yielding a low mismatch score of 35. (b) Abnormal window: the template fails to match the pathological morphology, with large residual (red shading) concentrated in the QRS and ST-T regions, yielding a score of 2119. Horizontal arrows annotate the QRS ($\sim $0--100\,ms) and ST-T ($\sim $100--310\,ms) segments.}}{17}{figure.9}\protected@file@percent }
\newlabel{fig:overlay}{{9}{17}{Template--signal alignment within a single 310\,ms (QT-interval) window. (a) Normal window: the best-matching template (dashed blue) closely tracks the signal (solid black), yielding a low mismatch score of 35. (b) Abnormal window: the template fails to match the pathological morphology, with large residual (red shading) concentrated in the QRS and ST-T regions, yielding a score of 2119. Horizontal arrows annotate the QRS ($\sim $0--100\,ms) and ST-T ($\sim $100--310\,ms) segments}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Per-subgroup AUROC for the top-6 methods on (a) PTB-XL and (b) CPSC 2018. Subgroups are divided into morphological (left of dashed line) and rhythm (right) categories. Error bars show $\pm $ 1 std over {\color  {blue}10} seeds.}}{18}{figure.10}\protected@file@percent }
\newlabel{fig:subgroup}{{10}{18}{Per-subgroup AUROC for the top-6 methods on (a) PTB-XL and (b) CPSC 2018. Subgroups are divided into morphological (left of dashed line) and rhythm (right) categories. Error bars show $\pm $ 1 std over \rev {10} seeds}{figure.10}{}}
