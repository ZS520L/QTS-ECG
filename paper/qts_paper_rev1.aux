\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color  {blue}Paired per-seed differences in AUROC (QTS $-$ baseline) on (a) PTB-XL and (b) CPSC 2018, ordered by mean difference. Grey dots are the ten individual seed differences; the diamond with horizontal bars marks the mean and its 95\% confidence interval (blue for the Deep SVDD comparison, red otherwise); the vertical line is zero.} Intervals excluding zero indicate significance at the seed level; the Deep SVDD interval lies entirely below zero on PTB-XL and entirely above zero on CPSC 2018.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:paired}{{5}{14}{\rev {Paired per-seed differences in AUROC (QTS $-$ baseline) on (a) PTB-XL and (b) CPSC 2018, ordered by mean difference. Grey dots are the ten individual seed differences; the diamond with horizontal bars marks the mean and its 95\% confidence interval (blue for the Deep SVDD comparison, red otherwise); the vertical line is zero.} Intervals excluding zero indicate significance at the seed level; the Deep SVDD interval lies entirely below zero on PTB-XL and entirely above zero on CPSC 2018}{figure.5}{}}
